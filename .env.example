# Local development ONLY. Copy to .env (ignored by Git), then replace placeholders.
POSTGRES_USER=bojong_dev
POSTGRES_DB=bojong_united_dev
POSTGRES_PORT=5433
POSTGRES_PASSWORD=REPLACE_WITH_LOCAL_ONLY_PASSWORD
DATABASE_URL="postgresql://bojong_dev:REPLACE_WITH_LOCAL_ONLY_PASSWORD@127.0.0.1:5433/bojong_united_dev?schema=public"

# Required opt-in for the development seed; never enable in production.
ALLOW_DEV_SEED=false

# Auth.js: generate a strong random secret locally; never commit the real value.
AUTH_SECRET=REPLACE_WITH_SECURE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
AUTH_URL=http://localhost:3000
# Only true behind a trusted proxy that removes spoofed forwarded headers.
AUTH_TRUST_PROXY_HEADERS=false

# Development test accounts only. No passwords are supplied by the repository.
ALLOW_DEV_ACCOUNT_PROVISION=false
TEST_TEACHER_PASSWORD=
TEST_DIMAS_PASSWORD=
TEST_AISYAH_PASSWORD=

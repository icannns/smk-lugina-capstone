# Local development ONLY. Copy to .env (ignored by Git), then replace placeholders.
POSTGRES_USER=bojong_dev
POSTGRES_DB=bojong_united_dev
POSTGRES_PORT=5433
POSTGRES_PASSWORD=REPLACE_WITH_LOCAL_ONLY_PASSWORD
DATABASE_URL="postgresql://bojong_dev:REPLACE_WITH_LOCAL_ONLY_PASSWORD@127.0.0.1:5433/bojong_united_dev?schema=public"

# Required opt-in for the development seed; never enable in production.
ALLOW_DEV_SEED=false

# Auth.js: generate a strong random secret locally; never commit the real value.
AUTH_SECRET=REPLACE_WITH_SECURE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
AUTH_URL=http://localhost:3000
# Only true behind a trusted proxy that removes spoofed forwarded headers.
AUTH_TRUST_PROXY_HEADERS=false

# Development test accounts only. No passwords are supplied by the repository.
ALLOW_DEV_ACCOUNT_PROVISION=false
TEST_TEACHER_PASSWORD=
TEST_DIMAS_PASSWORD=
TEST_AISYAH_PASSWORD=

# Private submission files. Set an ABSOLUTE path outside public/.next/.git/node_modules.
# local is development-only; production requires explicit private S3 configuration.
FILE_STORAGE_DRIVER=local
FILE_STORAGE_LOCAL_ROOT=REPLACE_WITH_ABSOLUTE_PRIVATE_DIRECTORY
FILE_MAX_BYTES=10485760
FILE_DAILY_BYTES=209715200
FILE_UPLOADS_PER_MINUTE=30
FILE_DOWNLOADS_PER_MINUTE=60

# S3-compatible deployment: set driver=s3; bucket MUST be private.
FILE_S3_BUCKET=
FILE_S3_REGION=
FILE_S3_ENDPOINT=
FILE_S3_PREFIX=bojong-submissions/
FILE_S3_FORCE_PATH_STYLE=false
FILE_S3_ACCESS_KEY_ID=
FILE_S3_SECRET_ACCESS_KEY=
# Opt in only when infrastructure supplies the SDK credential chain/IAM role.
FILE_S3_USE_DEFAULT_CREDENTIALS=false
# Isolated local QA only. Requires ALLOW_DEV_SEED=true and a localhost test DB.
# Never enable in a deployed environment.
FILE_STORAGE_ALLOW_LOCAL_TEST=false

{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate --config prisma.config.ts",
    "db:generate": "prisma generate --config prisma.config.ts",
    "db:format": "prisma format --config prisma.config.ts",
    "db:validate": "prisma validate --config prisma.config.ts",
    "db:migrate:dev": "prisma migrate dev --config prisma.config.ts",
    "db:migrate:deploy": "prisma migrate deploy --config prisma.config.ts",
    "db:migrate:status": "prisma migrate status --config prisma.config.ts",
    "db:seed": "prisma db seed --config prisma.config.ts",
    "demo:content": "tsx prisma/refresh-demo-content.ts",
    "test:db:safety": "tsx --test tests/database-safety.test.ts",
    "test:db": "tsx --test tests/database.integration.test.ts",
    "auth:provision": "tsx prisma/provision-test-accounts.ts",
    "test:auth": "tsx --test tests/auth-validation.test.ts",
    "test:auth:browser": "tsx tests/auth-browser-regressions.mjs",
    "test:rest": "tsx tests/rest-api-regressions.mjs",
    "test:rest:browser": "tsx tests/rest-browser-integration.mjs",
    "test:uiux": "tsx tests/ui-ux-api-regressions.mjs",
    "files:cleanup": "tsx prisma/cleanup-submission-files.ts",
    "test:files:unit": "tsx --test tests/file-storage.test.ts",
    "test:files:api": "tsx tests/file-attachments-regressions.mjs",
    "test:files:browser": "tsx tests/file-attachments-browser.mjs",
    "test:qa:fixes": "tsx --test tests/final-qa-fixes.test.ts",
    "test:qa:fixes:browser": "tsx tests/final-qa-fixes-browser.mjs"
  },
  "engines": {
    "node": "^20.19 || ^22.12 || >=24.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1168.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "0.45.2",
    "next": "16.4.3",
    "next-auth": "5.0.0-beta.32",
    "pdfjs-dist": "5.4.624",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanitize-html": "2.18.2",
    "server-only": "0.0.1",
    "yauzl": "3.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "2.16.2",
    "@types/yauzl": "3.4.0",
    "dotenv": "18.0.10",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prisma": "7.10.1",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.8"
    }
  }
}
